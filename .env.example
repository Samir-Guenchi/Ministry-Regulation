# Groq API Configuration (Primary LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration (For Embeddings Only)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-large

# Data Source
DATA_DIRECTORY=C:\Users\Samir Guenchi\Desktop\RAG\Ministry-Regulation\data

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Redis Configuration (Optional - using local FAISS cache by default)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
USE_REDIS=false

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_WORKERS=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Semantic Cache Settings (FAISS-based)
CACHE_DIRECTORY=./cache
CACHE_TTL=86400
SIMILARITY_THRESHOLD=0.90

# Guardrails
ENABLE_POLITICAL_FILTER=true
REQUIRE_CITATIONS=true
MAX_QUERY_LENGTH=500
BLOCK_OUT_OF_SCOPE=true

# JSON Output Enforcement
FORCE_JSON_OUTPUT=true

# Google Gemini (Fallback)
GOOGLE_API_KEY=your_google_api_key
